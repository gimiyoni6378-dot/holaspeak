{
  "name": "holaspeak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Spanish learning PWA with Astryx UI components",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npx astryx doctor --built dist",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-holaspeak \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@astryxdesign/core": "0.7.17",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "htm": "3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.37.0"
  },
  "engines": {
    "node": "24.x"
  }
}
