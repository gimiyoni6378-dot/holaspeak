rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validProgress(p) {
      return p.keys().hasOnly(['xp','points','level','xpInLevel','xpToNextLevel','completed','month','streak','review','pronunciationDone','signupPromptSeen','quests','studyDates','attendanceDates','attendanceStreak','questDate'])
        && p.xp is int && p.xp >= 0 && p.xp <= 10000000
        && p.points == p.xp && p.level == int(p.xp / 100) + 1
        && p.xpInLevel == p.xp % 100 && p.xpToNextLevel == 100 - p.xp % 100
        && p.completed is int && p.completed >= 0 && p.completed <= 10000000
        && p.month is int && p.month >= 0 && p.month <= 10000000
        && p.streak is int && p.streak >= 0 && p.streak <= 10000000
        && p.studyDates is list && p.studyDates.size() <= 10000
        && p.attendanceDates is list && p.attendanceDates.size() <= 10000
        && p.attendanceStreak is int && p.attendanceStreak >= 0 && p.attendanceStreak <= 10000
        && p.questDate is string && p.questDate.size() == 10
        && p.review is int && p.review >= 0 && p.review <= 10000000
        && p.pronunciationDone is bool && p.signupPromptSeen is bool
        && p.quests.keys().hasOnly(['lesson','review','speak'])
        && p.quests.lesson is bool && p.quests.review is bool && p.quests.speak is bool;
    }
    function validUser(d, uid) {
      return d.keys().hasOnly(['uid','displayName','email','progress','revision','createdAt','updatedAt'])
        && d.uid == uid && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
        && d.email == request.auth.token.email && validProgress(d.progress)
        && d.revision is int && d.revision >= 0 && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid} {
      match /assessments/{id} {
        allow get: if owns(uid);
        allow list: if owns(uid) && request.query.limit <= 50;
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly(['id','reference','created','result','savedAt'])
          && request.resource.data.id == id && id.size() == 36
          && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 240
          && request.resource.data.created is int && request.resource.data.created > 0
          && request.resource.data.savedAt == request.time
          && request.resource.data.result.keys().hasOnly(['accuracy','fluency','completeness','pronunciation','words'])
          && request.resource.data.result.pronunciation is number
          && request.resource.data.result.pronunciation >= 0 && request.resource.data.result.pronunciation <= 100
          && request.resource.data.result.words is list && request.resource.data.result.words.size() <= 100;
        allow update, delete: if false;
      }
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validUser(request.resource.data, uid)
        && request.resource.data.revision == 0 && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validUser(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','revision','updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
