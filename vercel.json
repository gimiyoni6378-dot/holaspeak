{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": { "api/speech.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/synthesize", "destination": "/api/speech?action=synthesize" },
    { "source": "/assessments", "destination": "/api/speech?action=assessments" }
  ]
}
